{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Error"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "Bank": {
    "BaseUrl": "http://localhost:8080/",
    "Timeout": "00:00:10",
    "MaxRetryAttempts": 2,
    "RetryDelay": "00:00:00.200"
  },
  "AllowedHosts": "*"
}
